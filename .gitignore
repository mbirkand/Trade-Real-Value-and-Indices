# Only the files listed below are tracked. Everything else in this folder
# (raw data, inputs, R workspaces, results CSVs, archive) stays on this computer.
/*
!/.gitignore
!/README.md
!/index.html
!/RealValue.R
# old dashboard address: a redirect page to the indices dashboard
!/results/
/results/*
!/results/diagnostics_dashboard.html
# indices pipeline and dashboard (since 5 Nov 2026)
!/Indices/
/Indices/results/*
!/Indices/results/diagnostics_dashboard.html
!/Indices/results/OUTPUTS_README.md
.DS_Store
.Rhistory
.Rproj.user/
